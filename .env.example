# ====================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO HỆ THỐNG RAG CO3101
# ====================================================================

# Khóa API Google Gemini (Bắt buộc để mô hình sinh câu trả lời tự nhiên)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình Chunking (Sliding Window: 800 - 1000 ký tự, overlap 100 - 120 ký tự)
CHUNK_SIZE=900
CHUNK_OVERLAP=100

# Cấu hình Vector Embedding (Mô hình BGE-M3, số chiều D=1024)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
BATCH_SIZE=32

# Cấu hình Chỉ mục Faiss HNSW (M=16, efConstruction=200, efSearch=50)
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=50
TOP_K=3

# Cấu hình Truy xuất Đa phương thức (Mỗi bên lấy 15 chunks, gộp lại tổng 10 chunks)
VECTOR_SEARCH_TOP_K=15
BM25_TOP_K=15
RRF_TOP_N=10
RRF_K=60

# Ngưỡng lọc tương quan ngữ nghĩa (tau >= 0.50)
SIMILARITY_THRESHOLD=0.50

# Cấu hình mô hình sinh LLM (Google Gemini Flash)
LLM_MODEL_NAME=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=4096

